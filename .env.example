# ==============================================================================
# CONFIGURAÇÃO DO SURICATA MCP SERVER
# ==============================================================================

# Caminhos do Suricata (Ajuste conforme seu ambiente Linux, Docker ou Windows)
# No Windows padrão: C:\Program Files\Suricata\suricata.yaml
# No Linux padrão: /etc/suricata/suricata.yaml
SURICATA_CONFIG_PATH="C:/Program Files/Suricata/suricata.yaml"

# Caminho para o log de eventos EVE JSON
# No Windows padrão: C:\Program Files\Suricata\log\eve.json
# No Linux padrão: /var/log/suricata/eve.json
SURICATA_EVE_PATH="C:/Program Files/Suricata/log/eve.json"

# Diretório base de logs operacionais
SURICATA_LOG_DIR="C:/Program Files/Suricata/log"

# Caminho para o Unix Domain Socket (ou Named Pipe no Windows, se habilitado)
SURICATA_UNIX_SOCKET_PATH=""

# Executável do Suricata (para validação de configurações e análise offline)
# Deixe apenas 'suricata' se estiver no PATH, ou o caminho absoluto
SURICATA_EXECUTABLE="C:/Program Files/Suricata/suricata.exe"

# Executável do suricata-update (opcional)
SURICATA_UPDATE_EXECUTABLE=""

# Diretório de regras de detecção
SURICATA_RULES_DIR="C:/Program Files/Suricata/rules"

# Diretório seguro para regras locais criadas/modificadas pelo MCP
SURICATA_LOCAL_RULES_PATH="C:/Program Files/Suricata/rules/local.rules"

# Diretório permitido para ingestão e análise de arquivos PCAP
SURICATA_PCAP_ALLOWED_DIR="C:/Users/Natanael Krindges/.gemini/antigravity-ide/mcp/suricata/pcaps"

# Limites de Segurança
SURICATA_MAX_PCAP_SIZE_MB=100
SURICATA_MAX_RESULTS=500
SURICATA_COMMAND_TIMEOUT_SECONDS=30
SURICATA_MAX_CONCURRENT_TASKS=4
SURICATA_VERIFY_CONFIG_BEFORE_WRITE=true

# Modo de Operação e Segurança MCP
# Valores permitidos: somente_leitura | operacional | administrativo
MCP_OPERATION_MODE="operacional"
MCP_READ_ONLY=false

# Auditoria
MCP_AUDIT_ENABLED=true
MCP_AUDIT_LOG_PATH="C:/Users/Natanael Krindges/.gemini/antigravity-ide/mcp/suricata/audit.log"

# Diretório para saída de relatórios (PDF, XLSX, CSV, JSON)
MCP_REPORT_OUTPUT_DIR="C:/Users/Natanael Krindges/.gemini/antigravity-ide/mcp/suricata/reports_output"

# Transporte MCP (stdio ou sse)
MCP_TRANSPORT="stdio"
MCP_HOST="127.0.0.1"
MCP_PORT=8080

# Nível de log (DEBUG, INFO, WARNING, ERROR)
MCP_LOG_LEVEL="INFO"

