# ==============================================================================
# SURICATA MCP SERVER - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================
# Este arquivo serve como modelo de configuração para qualquer ambiente (Linux, Windows ou Docker).
# Copie este arquivo para .env na raiz do projeto:
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
#
# Para gerar automaticamente a configuração exata para a sua máquina, execute:
#   suricata-mcp --doctor

# ------------------------------------------------------------------------------
# 1. PRESET PADRÃO: LINUX & DOCKER (Descomente se estiver em Linux)
# ------------------------------------------------------------------------------
# SURICATA_CONFIG_PATH="/etc/suricata/suricata.yaml"
# SURICATA_EVE_PATH="/var/log/suricata/eve.json"
# SURICATA_LOG_DIR="/var/log/suricata"
# SURICATA_UNIX_SOCKET_PATH="/var/run/suricata/suricata-command.socket"
# SURICATA_EXECUTABLE="suricata"
# SURICATA_UPDATE_EXECUTABLE="suricata-update"
# SURICATA_RULES_DIR="/var/lib/suricata/rules"
# SURICATA_LOCAL_RULES_PATH="/var/lib/suricata/rules/local.rules"

# ------------------------------------------------------------------------------
# 2. PRESET PADRÃO: WINDOWS (Ativo por padrão para Windows)
# ------------------------------------------------------------------------------
SURICATA_CONFIG_PATH="C:/Program Files/Suricata/suricata.yaml"
SURICATA_EVE_PATH="C:/Program Files/Suricata/log/eve.json"
SURICATA_LOG_DIR="C:/Program Files/Suricata/log"
SURICATA_UNIX_SOCKET_PATH=""
SURICATA_EXECUTABLE="C:/Program Files/Suricata/suricata.exe"
SURICATA_UPDATE_EXECUTABLE=""
SURICATA_RULES_DIR="C:/Program Files/Suricata/rules"
SURICATA_LOCAL_RULES_PATH="C:/Program Files/Suricata/rules/local.rules"

# ------------------------------------------------------------------------------
# 3. DIRETÓRIOS OPERACIONAIS E FORENSES (Caminhos Relativos Seguros)
# ------------------------------------------------------------------------------
# Diretório restrito permitido para ingestão e análise de arquivos PCAP
SURICATA_PCAP_ALLOWED_DIR="./pcaps"

# Diretório para exportação de relatórios gerados (PDF, XLSX, CSV, JSON)
MCP_REPORT_OUTPUT_DIR="./reports_output"

# Trilha de auditoria estruturada (JSON Lines)
MCP_AUDIT_ENABLED=true
MCP_AUDIT_LOG_PATH="./audit.log"

# ------------------------------------------------------------------------------
# 4. LIMITES DE SEGURANÇA E PERFORMANCE
# ------------------------------------------------------------------------------
SURICATA_MAX_PCAP_SIZE_MB=100
SURICATA_MAX_RESULTS=500
SURICATA_COMMAND_TIMEOUT_SECONDS=30
SURICATA_MAX_CONCURRENT_TASKS=4
SURICATA_VERIFY_CONFIG_BEFORE_WRITE=true

# ------------------------------------------------------------------------------
# 5. CONTROLE DE ACESSO BASEADO EM FUNÇÃO (RBAC)
# ------------------------------------------------------------------------------
# Modos:
#   - somente_leitura: apenas consultas e telemetria (sem modificações)
#   - operacional:     consultas, análise forense de PCAP e relatórios (padrão)
#   - administrativo:  todas as 100 ferramentas liberadas (gestão de regras e config)
MCP_OPERATION_MODE="operacional"
MCP_READ_ONLY=false

# ------------------------------------------------------------------------------
# 6. PROTOCOLO E TRANSPORTE MCP
# ------------------------------------------------------------------------------
# Transporte: 'stdio' (padrão para clientes locais como Claude/Cursor) ou 'sse'
MCP_TRANSPORT="stdio"
MCP_HOST="127.0.0.1"
MCP_PORT=8080
MCP_LOG_LEVEL="INFO"
